# Secrets
*.pem
*.key
*.p12
secrets/
# macOS Finder 가 만든 secret 사본 (예: 'secret.skala 2.yaml')
secret*\ [0-9]*.yaml
secret*\ [0-9]*.yml

# K8s — secret 실값 (.example 파일만 git 에 커밋)
# secret.local.yaml 은 scripts/env-to-secret.sh 가 .env 에서 자동 생성.
# 후속 overlay (eks-staging / eks-prod) 추가 시 동일 패턴 추가.
k8s/base/secret.yaml
k8s/overlays/local/secret.yaml
k8s/overlays/local/secret.local.yaml
k8s/overlays/local/secret.local.yaml.real
k8s/overlays/local/secret.real.yaml
k8s/overlays/skala/secret.skala.yaml
k8s/overlays/skala/secret.skala.real.yaml

# Langfuse 자동생성 Secret (env-to-langfuse-secret.sh) — 실 DB 비밀번호 포함, 절대 커밋 금지.
k8s/base/langfuse-secret.yaml
k8s/base/langfuse-secret.real.yaml

# 일반화 — env-to-*-secret.sh / kubectl create secret -o yaml 산출물 (.test/.real/.bak 변종).
# `.example` 만 명시적 등록되어 commit 됨 (위 K8s 블록의 secret*.example.yaml 패턴 참조).
k8s/**/secret*.yaml.test
k8s/**/secret*.yaml.real
k8s/**/secret*.yaml.bak
k8s/**/secret*.yaml.tmp

# .env 백업/임시 변종 (.tmp.bak / .bak / .tmp / .old) — Finder copy 또는 수동 백업 시 실 secret 포함 가능.
.env*.bak
.env*.tmp
.env*.old
.env*.tmp.bak

# ArgoCD repository credential — GitHub PAT 포함, 클러스터에 직접 apply (절대 커밋 금지).
# 생성/적용: docs/ci-cd-plan.md §6.4 참조.
k8s/argocd/repo-secret.yaml

# kustomize 렌더 산출물 — 실 secret 이 포함될 수 있음 (make skala-apply 전 디버그용).
/json
json

# 실값 환경파일 — example 만 추적 (.env.skala 가 미커버 상태로 git add -A 위험했음, 2026-06-11)
.env.skala
# macOS Finder 복사본 (예: "secret.skala 2.yaml", "문서 2.md")
* [0-9].yaml
* [0-9].yml
* [0-9].md
