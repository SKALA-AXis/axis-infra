// ============================================================
// AXIS - DBML after V43 assistant memory and Peer+ LLM snapshots
// Snapshot date: 2026-06-12
// Scope: app/operational tables + flyway_schema_history. Views noted below.
// ============================================================

Project axis {
  database_type: 'PostgreSQL'
  Note: '''
    V43 crawler/parser-aware product schema with integrated issue storage,
    card_news anchor FKs, card_news status soft-delete, admin audit logs,
    context-engineering columns/views, auth users, personalization,
    notifications, password reset tokens, global search support,
    Today Insight report memory, assistant conversation memory, and
    Peer+ LLM analysis snapshots.
    V30 legacy archive remains in legacy_records, while crawler runs and
    parser fact tables are restored as first-class operational data.

    Required extensions:
      - uuid-ossp
      - pg_trgm

    Views not rendered:
      - issue_cards: SELECT * FROM card_news
      - raw_article_metadata_unified: raw_articles metadata compatibility view
      - peer_event_timeline: 180-day peer card timeline
      - general_event_timeline: 180-day sector-only card fallback timeline
      - peer_financial_trend: canonicalized peer financial metrics

    Materialized views not rendered:
      - sector_pulse: weekly sector/card aggregate for context engineering
  '''
}

Table flyway_schema_history {
  installed_rank int [pk]
  version varchar(50)
  description varchar(200) [not null]
  type varchar(20) [not null]
  script varchar(1000) [not null]
  checksum int
  installed_by varchar(100) [not null]
  installed_on timestamp [not null, default: `now()`]
  execution_time int [not null]
  success boolean [not null]

  Note: 'Flyway-managed migration history table.'
}

Table peer_companies {
  id varchar(50) [pk]
  name varchar(100) [not null]
  tier varchar(20) [not null, default: 'domestic']
  keywords "text[]" [default: `'{}'`]
  dart_period text
  dart_revenue_krwbn numeric(18,2)
  dart_operating_profit_krwbn numeric(18,2)
  dart_operating_margin_pct numeric(9,4)
  dart_revenue_growth_pct numeric(9,4)
  dart_operating_profit_growth_pct numeric(9,4)
  ax_revenue_share_pct numeric(9,4)
  contract_count int [not null, default: 0]
  core_keywords "text[]" [not null, default: `'{}'`]
  peer_plus_payload jsonb [not null, default: `'{}'::jsonb`]
  financial_history jsonb [not null, default: `'[]'::jsonb`]
  job_posting_history jsonb [not null, default: `'[]'::jsonb`]
  legacy_payload jsonb [not null, default: `'{}'::jsonb`]
  profile_snapshot jsonb [not null, default: `'{}'::jsonb`, note: 'Tier A static profile snapshot generated quarterly by axis-cron-profile-refresh.']
  profile_snapshot_version varchar(50)
  profile_snapshot_generated_at timestamptz
  financial_updated_at timestamptz
  is_active boolean [default: true]
  global_search_text text [not null, default: `''`]
  created_at timestamptz [default: `now()`]

  indexes {
    core_keywords [name: 'idx_peer_companies_core_keywords', type: gin]
    profile_snapshot_version [name: 'idx_peer_companies_snapshot_version']
    global_search_text [name: 'idx_peer_companies_global_search_trgm', type: gin, note: 'GIN trigram index using gin_trgm_ops.']
    (`COALESCE(financial_updated_at, created_at)`) [name: 'idx_peer_companies_updated_desc']
  }
}

Table crawl_cursors {
  source_name varchar(100) [pk]
  cursor_date date [not null]
  until_date date [not null]
  window_days int [not null]
  max_windows_per_run int [not null, default: 1]
  enabled boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]
}

Table crawl_runs {
  id uuid [pk]
  run_type varchar(30) [not null]
  source_name varchar(100) [not null]
  window_start date [not null]
  window_end date [not null]
  status varchar(30) [not null]
  inserted_count int [not null, default: 0]
  skipped_count int [not null, default: 0]
  error_message text
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  indexes {
    (source_name, started_at) [name: 'idx_crawl_runs_source_started']
    status [name: 'idx_crawl_runs_status']
    (window_start, window_end) [name: 'idx_crawl_runs_window']
  }
}

Table raw_articles {
  id bigserial [pk]
  source_name varchar(100) [not null]
  title varchar(500) [not null]
  content text
  url text [not null, unique]
  published_at timestamptz
  collected_at timestamptz [not null, default: `now()`]
  cluster_id bigint
  is_representative boolean
  processing_status varchar(40) [not null, default: 'RAW']
  importance_score float
  metadata jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [default: `now()`]
  source_type varchar(50) [not null, default: 'news']
  publisher varchar(150)
  url_hash varchar(32) [not null]
  company jsonb [not null, default: `'[]'::jsonb`]
  language varchar(10) [not null, default: 'ko']
  content_type varchar(30) [not null, default: 'news']
  crawl_status varchar(20) [not null, default: 'success']
  error_message text
  relevance_score float
  relevance_label varchar(20)
  relevance_reason text
  matched_companies jsonb [not null, default: `'[]'::jsonb`]
  matched_sectors jsonb [not null, default: `'[]'::jsonb`]
  importance_level varchar(20)
  qdrant_vector_id uuid
  crawl_run_id uuid [ref: > crawl_runs.id, note: 'ON DELETE SET NULL']

  indexes {
    url_hash [name: 'idx_raw_articles_url_hash']
    source_type [name: 'idx_raw_articles_source_type']
    published_at [name: 'idx_raw_articles_published_at']
    processing_status [name: 'idx_raw_articles_processing_status']
    company [name: 'idx_raw_articles_company', type: gin]
    matched_companies [name: 'idx_raw_articles_matched_companies', type: gin]
    qdrant_vector_id [name: 'idx_raw_articles_qdrant_vector_id']
  }
}

Table crawl_run_articles {
  id bigserial [pk]
  crawl_run_id uuid [not null, ref: > crawl_runs.id, note: 'ON DELETE CASCADE']
  raw_article_id bigint [ref: > raw_articles.id, note: 'ON DELETE SET NULL']
  url text [not null]
  url_hash varchar(32) [not null]
  discovered_at timestamptz [not null, default: `now()`]
  action varchar(30) [not null]
  fetch_status varchar(30)
  error_message text
  source_rank int
  raw_payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (crawl_run_id, url_hash) [unique, name: 'uq_crawl_run_articles_run_url']
    crawl_run_id [name: 'idx_crawl_run_articles_run']
    raw_article_id [name: 'idx_crawl_run_articles_article']
    action [name: 'idx_crawl_run_articles_action']
    url_hash [name: 'idx_crawl_run_articles_url_hash']
  }
}

Table raw_article_parse_results {
  raw_article_id bigint [pk, ref: > raw_articles.id, note: 'ON DELETE CASCADE']
  parser_version text
  parse_status text
  parser_quality_label text
  parser_result jsonb [not null, default: `'{}'::jsonb`]
  financial_record jsonb [not null, default: `'{}'::jsonb`]
  raw_payload jsonb [not null, default: `'{}'::jsonb`]
  warnings jsonb [not null, default: `'[]'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table raw_article_financial_metrics {
  id bigserial [pk]
  raw_article_id bigint [not null, ref: > raw_articles.id, note: 'ON DELETE CASCADE']
  metric_uid text [not null]
  source_type varchar(50) [not null]
  source_name varchar(100)
  peer_id varchar(50)
  period text
  period_year int
  period_quarter int
  period_type text
  metric_name text [not null]
  metric_label text
  metric_scope text
  business_area text
  value_numeric numeric(24,6)
  value_krwbn double
  value_krw numeric(24,2)
  unit text
  currency varchar(10) [default: 'KRW']
  source_page int
  source_table_uid text
  source_chunk_uid text
  confidence double
  extraction_method text
  evidence_text text
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (raw_article_id, metric_uid) [unique, name: 'uq_raw_article_financial_metric']
    (peer_id, period) [name: 'idx_raw_article_financial_metrics_peer_period']
    (metric_name, period) [name: 'idx_raw_article_financial_metrics_metric']
    (source_type, source_name) [name: 'idx_raw_article_financial_metrics_source']
    (peer_id, metric_name, period_year, period_quarter) [name: 'idx_financial_metrics_peer_metric_period']
    payload [name: 'idx_raw_article_financial_metrics_payload_gin', type: gin]
  }
}

Table raw_article_business_signals {
  id bigserial [pk]
  raw_article_id bigint [not null, ref: > raw_articles.id, note: 'ON DELETE CASCADE']
  signal_uid text [not null]
  source_type varchar(50) [not null]
  source_name varchar(100)
  peer_id varchar(50)
  period text
  period_year int
  period_quarter int
  period_type text
  business_area text [not null]
  signal_type text [not null]
  sentiment text
  summary text [not null]
  evidence_text text
  source_page int
  source_chunk_uid text
  confidence double
  extraction_method text
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (raw_article_id, signal_uid) [unique, name: 'uq_raw_article_business_signal']
    (peer_id, period) [name: 'idx_raw_article_business_signals_peer_period']
    (business_area, signal_type) [name: 'idx_raw_article_business_signals_area_type']
    (source_type, source_name) [name: 'idx_raw_article_business_signals_source']
    (peer_id, business_area, period_year, period_quarter) [name: 'idx_business_signals_peer_area_period']
    payload [name: 'idx_raw_article_business_signals_payload_gin', type: gin]
  }
}

Table card_news {
  id varchar(50) [pk]
  company varchar(50) [not null]
  peer_company_id varchar(50) [ref: > peer_companies.id]
  cluster_id bigint
  integrated_issue_id uuid [ref: > integrated_issues.id, note: 'ON DELETE SET NULL. IntegratedIssue payload used as the factual input for CardNewsAgent.']
  title varchar(500) [not null]
  summary_lines "text[]" [not null, default: `'{}'`]
  event_type varchar(50) [default: 'tech']
  importance varchar(20) [default: 'low']
  importance_score float [default: 0.0]
  implication jsonb [not null, default: `'{}'::jsonb`]
  sources jsonb [not null, default: `'[]'::jsonb`]
  primary_keyword_category varchar(80)
  keyword_categories jsonb [not null, default: `'[]'::jsonb`]
  keywords "text[]" [not null, default: `'{}'`]
  keyword_frequency jsonb [not null, default: `'{}'::jsonb`]
  source_raw_article_ids "bigint[]" [not null, default: `'{}'`]
  primary_raw_article_id bigint [ref: > raw_articles.id, note: 'ON DELETE SET NULL']
  source_articles jsonb [not null, default: `'[]'::jsonb`]
  evidence_payload jsonb [not null, default: `'{}'::jsonb`]
  image_assets jsonb [not null, default: `'[]'::jsonb`]
  legacy_payload jsonb [not null, default: `'{}'::jsonb`]
  status varchar(20) [not null, default: 'ACTIVE', note: 'Card lifecycle status. ACTIVE=visible, PENDING=hidden, DELETED=soft-deleted/restorable.']
  card_schema_version varchar(10) [not null, default: 'v1', note: 'Card schema generation: v1=legacy heuristic, v2=LLM summary/implication/action card.']
  evaluation_payload jsonb [not null, default: `'{}'::jsonb`, note: 'Context engineering evaluation results.']
  validation_pass boolean [default: false]
  validation_sc_score float [default: 0.0]
  global_search_text text [not null, default: `''`]
  created_at timestamptz [default: `now()`]

  indexes {
    peer_company_id [name: 'idx_card_news_peer_company_id']
    (status, created_at) [name: 'idx_card_news_status_created_at']
    keywords [name: 'idx_card_news_keywords', type: gin]
    keyword_categories [name: 'idx_card_news_keyword_categories', type: gin]
    source_raw_article_ids [name: 'idx_card_news_source_raw_article_ids', type: gin]
    primary_raw_article_id [name: 'idx_card_news_primary_raw_article']
    integrated_issue_id [name: 'idx_card_news_integrated_issue']
    (card_schema_version, created_at) [name: 'idx_card_news_schema_version']
    created_at [name: 'idx_card_news_unjudged_v2', note: 'Partial: card_schema_version = v2 AND evaluation_payload lacks llm_judge.']
    (peer_company_id, created_at) [name: 'idx_card_news_peer_created', note: 'Partial: peer_company_id IS NOT NULL.']
    global_search_text [name: 'idx_card_news_global_search_trgm', type: gin, note: 'GIN trigram index using gin_trgm_ops.']
    created_at [name: 'idx_card_news_created_desc']
  }
}

Table admin_audit_logs {
  id bigserial [pk]
  actor_user_id uuid
  actor_email varchar(320) [not null]
  action_type varchar(80) [not null]
  resource_type varchar(40) [not null]
  resource_id varchar(80) [not null]
  reason text
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'idx_admin_audit_logs_created_at']
    (resource_type, resource_id, created_at) [name: 'idx_admin_audit_logs_resource']
  }

  Note: 'Append-only admin activity log for card_news delete/restore and future admin actions.'
}

Table integrated_issues {
  id uuid [pk, default: `uuid_generate_v4()`]
  schema_version varchar(40) [not null, default: 'integrated_issue_v3']
  issue_key varchar(160) [not null, note: 'Idempotency key. Recommended values: cluster:{cluster_id}:v3 or raw:{raw_article_id}:v3.']
  cluster_id bigint
  representative_raw_article_id bigint [ref: > raw_articles.id, note: 'ON DELETE SET NULL. raw_articles.id that was actually analyzed when a cluster has many source articles.']
  main_company varchar(80)
  event_type varchar(80)
  source_family varchar(40)
  scope_type varchar(40)
  is_valid boolean [not null, default: false]
  confidence double
  status varchar(30) [not null, default: 'active', note: 'active/superseded/failed/review']
  is_current boolean [not null, default: true]
  superseded_by uuid [ref: > integrated_issues.id, note: 'ON DELETE SET NULL']
  headline text
  one_line_summary text
  analyzed_source_ids "bigint[]" [not null, default: `'{}'`, note: 'raw_articles.id list used as analytical basis.']
  source_ids "bigint[]" [not null, default: `'{}'`, note: 'All raw_articles.id values retained as source/citation candidates.']
  sectors "text[]" [not null, default: `'{}'`]
  mentioned_peer_companies "text[]" [not null, default: `'{}'`]
  content_summary text
  content_detailed_explanation text
  content_has_content boolean [not null, default: false]
  content_compression_method varchar(80)
  content_basis_scope varchar(80)
  content_source_count int [not null, default: 0]
  content_section_count int [not null, default: 0]
  issue_brief jsonb [not null, default: `'{}'::jsonb`]
  analysis_ready_inputs jsonb [not null, default: `'{}'::jsonb`]
  content_digest jsonb [not null, default: `'{}'::jsonb`]
  issue_frame jsonb [not null, default: `'{}'::jsonb`]
  sources jsonb [not null, default: `'[]'::jsonb`]
  evidence jsonb [not null, default: `'{}'::jsonb`]
  quality jsonb [not null, default: `'{}'::jsonb`]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  payload jsonb [not null, default: `'{}'::jsonb`, note: 'Full integrated_issue_v3 JSON object returned by IssueIntegrationAgent.']
  payload_hash varchar(64)
  global_search_text text [not null, default: `''`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (schema_version, issue_key, is_current) [name: 'idx_integrated_issues_schema_issue_key_current', note: 'SQL enforces a partial unique index on (schema_version, issue_key) where is_current = true.']
    (cluster_id, is_current, created_at) [name: 'idx_integrated_issues_cluster_current']
    (representative_raw_article_id, created_at) [name: 'idx_integrated_issues_representative']
    (main_company, event_type, created_at) [name: 'idx_integrated_issues_company_event']
    (is_valid, is_current, created_at) [name: 'idx_integrated_issues_valid_current']
    analyzed_source_ids [name: 'idx_integrated_issues_analyzed_sources', type: gin]
    source_ids [name: 'idx_integrated_issues_source_ids', type: gin]
    sectors [name: 'idx_integrated_issues_sectors', type: gin]
    mentioned_peer_companies [name: 'idx_integrated_issues_peer_companies', type: gin]
    payload [name: 'idx_integrated_issues_payload_gin', type: gin]
    content_digest [name: 'idx_integrated_issues_content_digest_gin', type: gin]
    issue_frame [name: 'idx_integrated_issues_issue_frame_gin', type: gin]
    evidence [name: 'idx_integrated_issues_evidence_gin', type: gin]
    global_search_text [name: 'idx_integrated_issues_global_search_trgm', type: gin, note: 'GIN trigram index using gin_trgm_ops.']
  }

  Note: 'Canonical storage for IssueIntegrationAgent output. Keeps full payload plus queryable fields for downstream analysis agents.'
}

Table integrated_issue_source_articles {
  id bigserial [pk]
  integrated_issue_id uuid [not null, ref: > integrated_issues.id, note: 'ON DELETE CASCADE']
  raw_article_id bigint [ref: > raw_articles.id, note: 'ON DELETE SET NULL']
  source_order int [not null, default: 0]
  is_analyzed_basis boolean [not null, default: false, note: 'True when the article was actually analyzed, not only retained as a citation/source candidate.']
  title text
  source_name varchar(100)
  source_type varchar(50)
  publisher varchar(150)
  published_at timestamptz
  url text
  relevance_label varchar(30)
  relevance_score double
  source_payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (integrated_issue_id, raw_article_id) [unique, name: 'uq_integrated_issue_source_article']
    (integrated_issue_id, source_order) [name: 'idx_integrated_issue_sources_issue_order']
    raw_article_id [name: 'idx_integrated_issue_sources_raw_article']
    (integrated_issue_id, is_analyzed_basis) [name: 'idx_integrated_issue_sources_basis']
    source_payload [name: 'idx_integrated_issue_sources_payload_gin', type: gin]
  }

  Note: 'Normalized source list for an integrated issue. Mirrors the public sources array with raw_articles FK support.'
}

Table integrated_issue_content_sections {
  id bigserial [pk]
  integrated_issue_id uuid [not null, ref: > integrated_issues.id, note: 'ON DELETE CASCADE']
  section_key varchar(80) [not null]
  section_order int [not null, default: 0]
  title text
  summary text
  details text
  key_points "text[]" [not null, default: `'{}'`]
  raw_article_ids "bigint[]" [not null, default: `'{}'`]
  evidence_ref_ids "text[]" [not null, default: `'{}'`]
  section_payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (integrated_issue_id, section_key) [unique, name: 'uq_integrated_issue_content_section']
    (integrated_issue_id, section_order) [name: 'idx_integrated_issue_sections_issue_order']
    section_key [name: 'idx_integrated_issue_sections_key']
    raw_article_ids [name: 'idx_integrated_issue_sections_raw_articles', type: gin]
    evidence_ref_ids [name: 'idx_integrated_issue_sections_evidence_refs', type: gin]
    section_payload [name: 'idx_integrated_issue_sections_payload_gin', type: gin]
  }

  Note: 'Normalized content_digest.sections for section-level retrieval by Summary, Analysis, CardNews, Mixer, and KeywordGraph agents.'
}

Table integrated_issue_evidence_references {
  id bigserial [pk]
  integrated_issue_id uuid [not null, ref: > integrated_issues.id, note: 'ON DELETE CASCADE']
  evidence_ref_id varchar(40) [not null]
  evidence_text text [not null]
  source_ids "bigint[]" [not null, default: `'{}'`]
  reference_payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (integrated_issue_id, evidence_ref_id) [unique, name: 'uq_integrated_issue_evidence_ref']
    integrated_issue_id [name: 'idx_integrated_issue_evidence_issue']
    source_ids [name: 'idx_integrated_issue_evidence_source_ids', type: gin]
    evidence_text [name: 'idx_integrated_issue_evidence_text_trgm', type: gin, note: 'GIN trigram index using gin_trgm_ops.']
    reference_payload [name: 'idx_integrated_issue_evidence_payload_gin', type: gin]
  }

  Note: 'Deduplicated evidence.references text store. Facts and frames can point here by evidence_ref_id.'
}

Table market_price_ohlcv {
  id bigserial [pk]
  raw_article_id bigint [ref: > raw_articles.id, note: 'ON DELETE SET NULL']
  instrument_id bigint
  peer_id text
  peer_company_id varchar(50) [ref: > peer_companies.id, note: 'ON DELETE SET NULL']
  ticker text [not null]
  exchange varchar(20) [not null, default: 'KRX']
  instrument_name varchar(100)
  trade_date date [not null]
  open numeric
  high numeric
  low numeric
  close numeric
  volume bigint
  change_pct numeric
  currency text [default: 'KRW']
  source_type text [not null, default: 'market_data']
  source_name text
  publisher text
  collected_at timestamptz
  payload jsonb [not null, default: `'{}'::jsonb`]
  instrument_payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (ticker, trade_date, source_name) [unique, name: 'uq_market_price_ohlcv_ticker_date_source']
    (peer_company_id, trade_date) [name: 'idx_market_price_ohlcv_peer_company_date']
    (exchange, ticker, trade_date) [name: 'idx_market_price_ohlcv_exchange_ticker_date']
  }
}

Table briefing_reports {
  id varchar(40) [pk]
  title varchar(500) [not null]
  briefing_type varchar(20) [not null]
  date_from date [not null]
  date_to date [not null]
  report_date date
  period_label text
  requested_by_user_id bigint
  status varchar(20) [not null, default: 'queued']
  progress numeric(3,2) [not null, default: 0.0]
  key_summary text
  sk_implication text
  related_card_ids "text[]" [not null, default: `'{}'`]
  primary_card_news_id varchar(50) [ref: > card_news.id, note: 'ON DELETE SET NULL']
  primary_peer_company_id varchar(50) [ref: > peer_companies.id, note: 'ON DELETE SET NULL']
  related_raw_article_ids "bigint[]" [not null, default: `'{}'`]
  recipients jsonb [not null, default: `'[]'::jsonb`]
  delivery_history jsonb [not null, default: `'[]'::jsonb`]
  payload jsonb
  legacy_payload jsonb [not null, default: `'{}'::jsonb`]
  error_message text
  confidence numeric(3,2)
  provenance jsonb
  global_search_text text [not null, default: `''`]
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    primary_card_news_id [name: 'idx_briefing_reports_primary_card_news']
    primary_peer_company_id [name: 'idx_briefing_reports_primary_peer_company']
    global_search_text [name: 'idx_briefing_reports_global_search_trgm', type: gin, note: 'GIN trigram index using gin_trgm_ops.']
    (`COALESCE(report_date, date_to, date_from)`, created_at) [name: 'idx_briefing_reports_report_date_desc']
  }
}

Table mixer_results {
  id uuid [pk, default: `uuid_generate_v4()`]
  source_analysis_id varchar(100) [unique]
  title varchar(300)
  requested_by_user_id bigint
  user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  input_card_ids "text[]" [not null, default: `'{}'`]
  primary_card_news_id varchar(50) [ref: > card_news.id, note: 'ON DELETE SET NULL']
  input_peer_ids "text[]" [not null, default: `'{}'`]
  primary_peer_company_id varchar(50) [ref: > peer_companies.id, note: 'ON DELETE SET NULL']
  input_keywords "text[]" [not null, default: `'{}'`]
  ratios jsonb [not null, default: `'{}'::jsonb`]
  generated_implication jsonb [not null, default: `'{}'::jsonb`]
  insight_brief jsonb [not null, default: `'[]'::jsonb`]
  radar_axes jsonb [not null, default: `'[]'::jsonb`]
  connections jsonb [not null, default: `'[]'::jsonb`]
  sk_ax_implication text
  final_one_liner text
  confidence numeric(3,2)
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    primary_card_news_id [name: 'idx_mixer_results_primary_card_news']
    primary_peer_company_id [name: 'idx_mixer_results_primary_peer_company']
    (user_id, created_at) [name: 'idx_mixer_results_user_created', note: 'Partial: user_id IS NOT NULL.']
  }
}

Table insight_reports {
  id uuid [pk, default: `uuid_generate_v4()`]
  source_analysis_id varchar(100) [unique]
  title varchar(300)
  insight_type varchar(40) [not null, default: 'cascade']
  status varchar(30) [not null, default: 'completed']
  requested_by_user_id bigint
  focus_peer_ids "text[]" [not null, default: `'{}'`]
  primary_peer_company_id varchar(50) [ref: > peer_companies.id, note: 'ON DELETE SET NULL']
  focus_card_ids "text[]" [not null, default: `'{}'`]
  focus_keywords "text[]" [not null, default: `'{}'`]
  date_from date
  date_to date
  summary text
  final_one_liner text
  sk_ax_implication text
  reasoning_steps jsonb [not null, default: `'[]'::jsonb`]
  evidence jsonb [not null, default: `'[]'::jsonb`]
  source_card_ids "text[]" [not null, default: `'{}'`]
  primary_card_news_id varchar(50) [ref: > card_news.id, note: 'ON DELETE SET NULL']
  confidence numeric(3,2)
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    primary_card_news_id [name: 'idx_insight_reports_primary_card_news']
    primary_peer_company_id [name: 'idx_insight_reports_primary_peer_company']
  }
}

Table global_industry_trends {
  id uuid [pk, default: `uuid_generate_v4()`]
  source_analysis_id varchar(100) [unique]
  trend_date date [not null, default: `current_date`]
  industry varchar(100) [not null]
  region varchar(50) [not null, default: 'global']
  keyword varchar(120) [not null]
  keyword_category varchar(80)
  title varchar(300)
  summary text
  mention_count int [not null, default: 0]
  impact_score numeric(5,2)
  confidence numeric(3,2)
  related_peer_ids "text[]" [not null, default: `'{}'`]
  related_card_ids "text[]" [not null, default: `'{}'`]
  source_raw_article_ids "bigint[]" [not null, default: `'{}'`]
  sk_ax_implication text
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (trend_date, industry, region, keyword) [unique, name: 'uq_global_industry_trends_daily_keyword']
  }
}

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  email varchar(320) [not null]
  email_domain varchar(120) [not null]
  password_hash varchar(255) [not null]
  status varchar(20) [not null, default: 'PENDING']
  role varchar(20) [not null, default: 'USER']
  email_verified boolean [not null, default: false]
  failed_login_count int [not null, default: 0]
  locked_until timestamptz
  last_login_at timestamptz
  notification_preferences jsonb [not null, default: `'{ "enabled": true, "importantEnabled": true, "importantKeywords": ["수주", "계약", "실적", "투자"], "keywords": [] }'::jsonb`, note: 'User notification preferences: enabled, importantEnabled, importantKeywords, keywords.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    email [unique, name: 'uk_users_email']
    status [name: 'idx_users_status']
    role [name: 'idx_users_role']
  }

  Note: 'AXIS user accounts. status: PENDING/ACTIVE/SUSPENDED/WITHDRAWN. role: USER/ADMIN.'
}

Table auth_tokens {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  type varchar(30) [not null, note: 'EMAIL_VERIFICATION, REFRESH, PASSWORD_RESET.']
  token_hash varchar(128) [not null]
  token_family_id uuid
  previous_token_id uuid [ref: > auth_tokens.id, note: 'ON DELETE SET NULL']
  user_agent text
  ip_address varchar(64)
  expires_at timestamptz [not null]
  used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    token_hash [unique, name: 'uk_auth_tokens_hash']
    (user_id, type) [name: 'idx_auth_tokens_user_type']
    token_family_id [name: 'idx_auth_tokens_family', note: 'Partial: token_family_id IS NOT NULL.']
    expires_at [name: 'idx_auth_tokens_expires_at']
    (user_id, expires_at) [name: 'idx_auth_tokens_password_reset_active', note: 'Partial: type = PASSWORD_RESET AND used_at IS NULL AND revoked_at IS NULL.']
  }

  Note: 'Email verification, refresh, and password reset token store. Raw tokens are never persisted; only token_hash is stored.'
}

Table user_settings {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, unique, ref: > users.id, note: 'ON DELETE CASCADE']
  display_name varchar(120)
  department varchar(120)
  alert_rules jsonb [not null, default: `'{}'::jsonb`]
  notification_settings jsonb [not null, default: `jsonb_build_object('channels', jsonb_build_object('email', true, 'inApp', true, 'teams', false), 'briefingTime', '08:30', 'eventImmediate', true)`]
  view_preferences jsonb [not null, default: `'{}'::jsonb`]
  security_settings jsonb [not null, default: `jsonb_build_object('refreshCookie', true, 'autoLoginPolicy', 'refresh_token_only')`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_user_settings_user']
  }

  Note: 'User-scoped profile adjuncts, alert rules, notification settings, view preferences, and security settings.'
}

Table user_card_news_bookmarks {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  card_news_id varchar(50) [not null, ref: > card_news.id, note: 'ON DELETE CASCADE']
  note text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, card_news_id) [unique, name: 'uq_user_card_news_bookmark']
    (user_id, created_at) [name: 'idx_user_card_news_bookmarks_user']
    card_news_id [name: 'idx_user_card_news_bookmarks_card']
  }

  Note: 'Per-user card-news bookmarks used by personalized card lists and mixer inputs.'
}

Table user_notifications {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  notification_type varchar(50) [not null, default: 'CARD_NEWS']
  severity varchar(20) [not null, default: 'NORMAL', note: 'NORMAL or IMPORTANT.']
  source_type varchar(50) [not null, default: 'IN_APP']
  source_id varchar(100)
  source_url varchar(500)
  company_name varchar(100)
  title varchar(300) [not null]
  message text
  target_view varchar(50)
  target_resource_id varchar(100)
  matched_keywords jsonb [not null, default: `'[]'::jsonb`]
  payload jsonb [not null, default: `'{}'::jsonb`]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  dedupe_key varchar(200) [not null, note: 'Prevents duplicate notification creation per user/source/version/keyword.']
  read_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_user_notifications_user_created']
    (user_id, created_at) [name: 'idx_user_notifications_user_unread', note: 'Partial: read_at IS NULL.']
    (user_id, dedupe_key) [unique, name: 'uk_user_notifications_user_dedupe']
    (user_id, created_at) [name: 'idx_user_notifications_user_created_active', note: 'Partial: deleted_at IS NULL.']
    (user_id, read_at) [name: 'idx_user_notifications_user_unread_active', note: 'Partial: deleted_at IS NULL.']
    (source_type, source_id) [name: 'idx_user_notifications_source']
  }

  Note: 'Per-user in-app notification state. unread count and lists exclude deleted_at rows.'
}

Table user_access_logs {
  id bigserial [pk]
  user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  action_type varchar(60) [not null, note: 'SIGNUP, EMAIL_VERIFIED, EMAIL_VERIFICATION_RESENT, LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, REFRESH_ROTATED, REFRESH_REUSE_DETECTED, PASSWORD_CHANGED, PASSWORD_RESET_REQUESTED, PASSWORD_RESET_COMPLETED, PASSWORD_RESET_FAILED, PROFILE_UPDATED, SETTINGS_UPDATED.']
  success boolean [not null, default: true]
  ip_address varchar(64)
  user_agent text
  session_id uuid
  metadata jsonb [not null, default: `'{}'::jsonb`]
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, occurred_at) [name: 'idx_user_access_logs_user_time', note: 'Partial: user_id IS NOT NULL.']
    (action_type, occurred_at) [name: 'idx_user_access_logs_action_time']
  }

  Note: 'Security access history for signup/login/logout/refresh/password events. Auto-login is based on refresh tokens, not browsing history.'
}

Table today_insight_reports {
  id uuid [pk, default: `uuid_generate_v4()`]
  report_date date [not null]
  schema_version varchar(40) [not null, default: 'today_insight_v1']
  prompt_version varchar(80)
  status varchar(30) [not null, default: 'active', note: 'active, archived, failed, review.']
  headline text
  executive_summary text
  executive_implication text
  source_integrated_issue_ids "uuid[]" [not null, default: `'{}'`]
  source_card_ids "text[]" [not null, default: `'{}'`]
  source_raw_article_ids "bigint[]" [not null, default: `'{}'`]
  peer_ids "text[]" [not null, default: `'{}'`]
  sectors "text[]" [not null, default: `'{}'`]
  input_snapshot jsonb [not null, default: `'{}'::jsonb`, note: 'Exact DB/profile/ledger context sent to TodayInsightAgent.']
  output_payload jsonb [not null, default: `'{}'::jsonb`, note: 'UI-ready TodayInsightGenerateResponse payload.']
  provenance jsonb [not null, default: `'{}'::jsonb`]
  confidence double
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (report_date, created_at) [name: 'idx_today_insight_reports_latest', note: "Partial: status = 'active'."]
    source_integrated_issue_ids [name: 'idx_today_insight_reports_integrated_issues', type: gin]
    source_card_ids [name: 'idx_today_insight_reports_cards', type: gin]
    peer_ids [name: 'idx_today_insight_reports_peers', type: gin]
    sectors [name: 'idx_today_insight_reports_sectors', type: gin]
    output_payload [name: 'idx_today_insight_reports_output_payload', type: gin]
    input_snapshot [name: 'idx_today_insight_reports_input_snapshot', type: gin]
  }

  Note: 'Daily home dashboard insight memory. Stores TodayInsightAgent input_snapshot and output_payload JSONB for durable context.'
}

Table assistant_conversations {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  device_id_hash varchar(128)
  title varchar(200)
  summary text
  status varchar(20) [not null, default: 'active', note: 'active, ended, archived, deleted.']
  last_message_at timestamptz
  message_count int [not null, default: 0]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, last_message_at, created_at) [name: 'idx_assistant_conversations_user_latest', note: "Partial: user_id IS NOT NULL AND status <> 'deleted'."]
    (device_id_hash, last_message_at, created_at) [name: 'idx_assistant_conversations_device_latest', note: "Partial: device_id_hash IS NOT NULL AND status <> 'deleted'."]
  }

  Note: 'Floating assistant conversation thread. Owned by users.id when logged in, otherwise by hashed HttpOnly device id.'
}

Table assistant_messages {
  id uuid [pk, default: `uuid_generate_v4()`]
  conversation_id uuid [not null, ref: > assistant_conversations.id, note: 'ON DELETE CASCADE']
  turn_idx int [not null]
  role varchar(20) [not null, note: 'user, assistant, system.']
  content text [not null]
  intent varchar(60)
  scope varchar(60)
  entities jsonb [not null, default: `'{}'::jsonb`]
  answer_payload jsonb [not null, default: `'{}'::jsonb`]
  sources jsonb [not null, default: `'[]'::jsonb`, note: 'Grounding sources used in the assistant answer.']
  retrieval_trace jsonb [not null, default: `'{}'::jsonb`]
  handoff jsonb [not null, default: `'{}'::jsonb`, note: 'Navigation handoff payload.']
  safety jsonb [not null, default: `'{}'::jsonb`]
  confidence double
  langfuse_trace_id varchar(100)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, turn_idx) [unique, name: 'uq_assistant_messages_turn']
    (conversation_id, turn_idx) [name: 'idx_assistant_messages_conversation']
    created_at [name: 'idx_assistant_messages_created_at']
    (intent, created_at) [name: 'idx_assistant_messages_intent', note: 'Partial: intent IS NOT NULL.']
    sources [name: 'idx_assistant_messages_sources_gin', type: gin]
    handoff [name: 'idx_assistant_messages_handoff_gin', type: gin]
    langfuse_trace_id [name: 'idx_assistant_messages_trace', note: 'Partial: langfuse_trace_id IS NOT NULL.']
  }

  Note: 'Assistant/user turns. Sources, retrieval trace, safety decisions, and page handoff payloads are kept in compact JSONB.'
}

Table peer_llm_analysis_snapshots {
  id uuid [pk, default: `uuid_generate_v4()`]
  analysis_type varchar(80) [not null, default: 'peer_swot_comparison']
  scope varchar(30) [not null, note: 'all or company.']
  peer_id text [not null, note: 'all, samsung_sds, lg_cns, hyundai_autoever, posco_dx, etc.']
  reference_peer_id text [not null, default: 'sk_ax']
  comparison_mode varchar(80) [not null]
  schema_version varchar(40) [not null, default: 'peer_swot_comparison_v1']
  prompt_version varchar(80) [not null]
  model_name varchar(80)
  status varchar(30) [not null, default: 'active', note: 'active, archived, failed, review.']
  evidence_hash varchar(80) [not null, note: 'Hash of the compact input evidence pack.']
  input_snapshot jsonb [not null, default: `'{}'::jsonb`, note: 'Compact evidence pack sent to the LLM.']
  output_payload jsonb [not null, default: `'{}'::jsonb`, note: 'Validated UI-ready JSON from Peer+ LLM analysis.']
  analysis_trace jsonb [not null, default: `'[]'::jsonb`]
  provenance jsonb [not null, default: `'{}'::jsonb`]
  confidence double
  source_raw_article_ids "bigint[]" [not null, default: `'{}'`]
  source_signal_ids "bigint[]" [not null, default: `'{}'`]
  source_metric_ids "bigint[]" [not null, default: `'{}'`]
  peer_ids "text[]" [not null, default: `'{}'`]
  generated_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (analysis_type, scope, peer_id, comparison_mode, generated_at, created_at) [name: 'idx_peer_llm_analysis_snapshots_latest', note: "Partial: status = 'active'."]
    expires_at [name: 'idx_peer_llm_analysis_snapshots_expires_at', note: "Partial: status = 'active' AND expires_at IS NOT NULL."]
    peer_ids [name: 'idx_peer_llm_analysis_snapshots_peer_ids', type: gin]
    source_raw_article_ids [name: 'idx_peer_llm_analysis_snapshots_raw_articles', type: gin]
    source_signal_ids [name: 'idx_peer_llm_analysis_snapshots_signals', type: gin]
    source_metric_ids [name: 'idx_peer_llm_analysis_snapshots_metrics', type: gin]
    output_payload [name: 'idx_peer_llm_analysis_snapshots_output_payload', type: gin]
    input_snapshot [name: 'idx_peer_llm_analysis_snapshots_input_snapshot', type: gin]
    analysis_trace [name: 'idx_peer_llm_analysis_snapshots_analysis_trace', type: gin]
    (analysis_type, peer_id, comparison_mode, evidence_hash, prompt_version, model_name) [unique, name: 'uq_peer_llm_analysis_snapshots_evidence', note: "Physical index uses COALESCE(model_name, '')."]
  }

  Note: 'Peer+ LLM comparison/SWOT analysis snapshots. Stores compact input evidence and UI-ready output JSON.'
}

Table legacy_records {
  id bigserial [pk]
  source_table varchar(100) [not null]
  source_pk text
  owner_table varchar(100)
  owner_id text
  payload jsonb [not null]
  archived_at timestamptz [not null, default: `now()`]

  indexes {
    (source_table, source_pk) [unique, name: 'uq_legacy_records_source_pk']
    (source_table, archived_at) [name: 'idx_legacy_records_source']
    (owner_table, owner_id) [name: 'idx_legacy_records_owner']
  }

  Note: 'Data-retention archive for V30-collapsed legacy tables; excluded from product ERD views.'
}

TableGroup "Minimal Product ERD" {
  peer_companies
  raw_articles
  raw_article_parse_results
  raw_article_financial_metrics
  raw_article_business_signals
  integrated_issues
  integrated_issue_source_articles
  integrated_issue_content_sections
  integrated_issue_evidence_references
  card_news
  market_price_ohlcv
  briefing_reports
  mixer_results
  insight_reports
  global_industry_trends
  today_insight_reports
  peer_llm_analysis_snapshots
}

TableGroup "Auth / Personalization" {
  users
  auth_tokens
  user_settings
  user_card_news_bookmarks
  user_notifications
  user_access_logs
  assistant_conversations
  assistant_messages
  admin_audit_logs
}

TableGroup "Operational State / Retention" {
  crawl_cursors
  crawl_runs
  crawl_run_articles
  legacy_records
}

TableGroup "DB Management" {
  flyway_schema_history
}
