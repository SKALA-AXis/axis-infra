# ============================================================
# AXIS — 환경변수 템플릿 (in-cluster DB 모드 단일화)
#
# 사용법:
#   cp .env.example .env
#   $EDITOR .env                              # 실값 채움
#
# DB / Qdrant 모드 (Supabase·Qdrant Cloud 폐기 — 2026-05-08):
#   · SKALA EKS 배포: in-namespace Postgres + Qdrant. 본 .env 의 POSTGRES_*
#     키 + scripts/env-to-skala-secret.sh 가 axis-postgres-bootstrap·axis-secrets 자동 생성.
#   · 로컬 docker compose: .env.local 사용 (별도 in-cluster postgres 컨테이너).
#
# .env 파일은 절대 커밋하지 마세요!  (.gitignore 등록됨)
# ============================================================

# ─── PostgreSQL (in-namespace 또는 in-cluster 컨테이너) ──────
# SKALA: postgres.yaml 의 Service "postgres" 가 본 user/db/pw 로 부트스트랩.
# 로컬 (docker compose --profile local): postgres 컨테이너 초기화 값.
# 강한 password 권장:  openssl rand -base64 24
POSTGRES_DB=axis
POSTGRES_USER=axuser
POSTGRES_PASSWORD=<REPLACE_DB_PW_RANDOM>

# 호스트는 모두 service 짧은 이름 'postgres' (같은 namespace / 같은 docker network).
# scripts/env-to-skala-secret.sh 는 POSTGRES_* 에서 아래 URL 들을 자동 derive 하므로
# SKALA 배포 시엔 다음 줄들 직접 안 채워도 됨. 로컬 docker compose 시엔 필요.
DATABASE_URL=postgresql://axuser:<REPLACE_DB_PW_RANDOM>@postgres:5432/axis
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/axis
SPRING_DATASOURCE_USERNAME=axuser
SPRING_DATASOURCE_PASSWORD=<REPLACE_DB_PW_RANDOM>

# ─── Qdrant (in-namespace 또는 in-cluster 컨테이너) ──────────
# SKALA: qdrant.yaml 의 Service "qdrant".  로컬: docker compose 의 qdrant 서비스.
# API key 인증 미설정 (현재 단계). Qdrant Cloud 폐기됨.
QDRANT_HOST=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── SpringBoot → Python AI 서버 ────────────────────────────
AI_SERVER_URL=http://ai:8001

# ─── 카드 뉴스 이미지 저장소 ────────────────────────────────
# 컨테이너 안에서 axis-images 볼륨이 마운트되는 경로.
# axis-ai (ImageFetchAgent) 가 write, axis-backend 가 read-only 로 서빙.
IMAGE_STORAGE_PATH=/data/images

# ─── Crawler API keys ───────────────────────────────────────
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...
NAVER_CLIENT_IDS=...
NAVER_CLIENT_SECRETS=...
DART_API_KEY=...
KIPRIS_API_KEY=...
SARAMIN_API_KEY=...

# ─── Email (v3 — Slack 폐기, 이메일 발송으로 전환) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=axis-briefing@sk.com
BRIEFING_TIME=08:30
BRIEFING_RECIPIENTS=user1@sk.com,user2@sk.com

# ─── MLflow ─────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Spring Profile (local / prod) ──────────────────────────
SPRING_PROFILES_ACTIVE=local
AXIS_AUTH_ENFORCE=true
AXIS_AUTH_ALLOWED_EMAIL_DOMAINS=*
AXIS_AUTH_EMAIL_VERIFICATION_DELIVERY=log
AXIS_APP_BASE_URL=http://localhost:3100

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─── 인증 / 내부 토큰 (K8s Secret 으로 주입) ────────────────
# AXIS_AUTH_JWT_SECRET — backend Spring Security (application.yml 의 jwt-secret)
# 32바이트 이상 권장. 생성: openssl rand -hex 32
# ⚠ JWT_SECRET 키는 사용하지 않음 (legacy, backend 미참조).
AXIS_AUTH_JWT_SECRET=change-me-to-random-32-bytes-or-more

# CRON_INTERNAL_TOKEN — K8s CronJob → backend 내부 통신 (B7)
# 생성: openssl rand -hex 16
CRON_INTERNAL_TOKEN=local-dev-cron-token

# SLACK_WEBHOOK_URL — CronJob 실패 Slack 알림 (axis-cron-failure-notifier)
# 비우면 알림 비활성. Slack App → Incoming Webhooks 에서 발급.
SLACK_WEBHOOK_URL=

# ─── Langfuse Cloud (LLM trace 관측 — P9) ──────────────────
# Langfuse Cloud (https://cloud.langfuse.com 의 jp/us/eu region) 의 Project 에
# 가입 후 발급받은 API keys. self-host 폐기 (2026-05-14, refactor PR):
#   · chart 0.8.0=v2 의 OTel endpoint 미지원 (검증: HTTP 404)
#   · chart 0.9.0+=v3 는 ClickHouse+Valkey+Zookeeper+MinIO 5+ PVC → team13 quota 초과
#   → 외부 SaaS 채택.
#
# 가입: https://cloud.langfuse.com → region 선택 → Project → API keys 발급.
# 무료 tier: 50K observations/월 (우리 매시 7 LLM × 24h × 30 ≈ 5K — 여유 10배).
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
