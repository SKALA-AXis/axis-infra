# ============================================================
# AXIS — 환경변수 템플릿
# cp .env.example .env 후 실제 값을 채워주세요.
# .env 파일은 절대 커밋하지 마세요!
# ============================================================

# ─── PostgreSQL (Supabase) ──────────────────────────────────
# Python(SQLAlchemy/psycopg) 연결 문자열.
# 비밀번호에 특수문자가 있으면 percent-encoding 적용 필수 (% → %25 등).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# SpringBoot용 JDBC 연결 (driver는 host:port/db 형식 그대로 사용)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<password>

# ─── Qdrant Cloud ───────────────────────────────────────────
QDRANT_HOST=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=<qdrant-cloud-api-key>

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── SpringBoot → Python AI 서버 ────────────────────────────
AI_SERVER_URL=http://ai:8001

# ─── Crawler API keys ───────────────────────────────────────
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...
DART_API_KEY=...
KIPRIS_API_KEY=...
SARAMIN_API_KEY=...

# ─── Email (v3 — Slack 폐기, 이메일 발송으로 전환) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=axis-briefing@sk.com
BRIEFING_TIME=08:30
BRIEFING_RECIPIENTS=user1@sk.com,user2@sk.com

# ─── MLflow ─────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Spring Profile (local / prod) ──────────────────────────
SPRING_PROFILES_ACTIVE=local

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
