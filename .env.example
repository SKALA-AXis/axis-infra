# ============================================================
# AXIS — 환경변수 템플릿 (Cloud 모드: Supabase + Qdrant Cloud)
# 사용법:
#   cp .env.example .env
#   docker compose up -d                     # postgres·qdrant 컨테이너는 띄우지 않음
#
# 로컬 컨테이너 DB로 테스트하려면:
#   cp .env.local.example .env.local
#   docker compose --profile local --env-file .env.local up -d
#
# .env / .env.local 파일은 절대 커밋하지 마세요!
# ============================================================

# ─── PostgreSQL (Supabase) ──────────────────────────────────
# Python(SQLAlchemy/psycopg) 연결 문자열.
# 비밀번호에 특수문자가 있으면 percent-encoding 적용 필수 (% → %25 등).
# Transaction Pooler 사용 시: aws-1-<region>.pooler.supabase.com:6543, username=postgres.<project-ref>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# SpringBoot용 JDBC 연결 — sslmode·prepareThreshold 같은 옵션은 URL 쿼리스트링에 직접 포함.
# Pooler 사용 시 prepareThreshold=0 필수 (PgBouncer transaction 모드 호환).
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<password>

# ─── Qdrant Cloud ───────────────────────────────────────────
QDRANT_HOST=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=<qdrant-cloud-api-key>

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── SpringBoot → Python AI 서버 ────────────────────────────
AI_SERVER_URL=http://ai:8001

# ─── 카드 뉴스 이미지 저장소 ────────────────────────────────
# 컨테이너 안에서 axis-images 볼륨이 마운트되는 경로.
# axis-ai (ImageFetchAgent) 가 write, axis-backend 가 read-only 로 서빙.
# 호스트 경로와는 무관 — docker-compose 의 named volume 'axis-images' 가 영속화.
IMAGE_STORAGE_PATH=/data/images

# ─── Crawler API keys ───────────────────────────────────────
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...
DART_API_KEY=...
KIPRIS_API_KEY=...
SARAMIN_API_KEY=...

# ─── Email (v3 — Slack 폐기, 이메일 발송으로 전환) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=axis-briefing@sk.com
BRIEFING_TIME=08:30
BRIEFING_RECIPIENTS=user1@sk.com,user2@sk.com

# ─── MLflow ─────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Spring Profile (local / prod) ──────────────────────────
SPRING_PROFILES_ACTIVE=local

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
