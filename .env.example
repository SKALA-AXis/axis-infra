# ============================================================
# AXIS — 환경변수 템플릿
# cp .env.example .env 후 실제 값을 채워주세요.
# .env 파일은 절대 커밋하지 마세요!
# ============================================================

# PostgreSQL
POSTGRES_DB=axis
POSTGRES_USER=axuser
POSTGRES_PASSWORD=axpass
DATABASE_URL=postgresql://axuser:axpass@postgres:5432/axis

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# OpenAI
OPENAI_API_KEY=sk-...

# SpringBoot → Python AI 서버
AI_SERVER_URL=http://ai:8001

# Crawler — Naver Search API
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...

# Crawler — DART 전자공시
DART_API_KEY=...

# Crawler — KIPRIS 특허·실용신안
KIPRIS_API_KEY=...

# Crawler — BigKinds 뉴스 빅데이터
BIGKINDS_API_KEY=...

# Crawler — Saramin 채용공고
SARAMIN_API_KEY=...

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_BRIEFING_TIME=08:30

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Spring Profile (local / prod)
SPRING_PROFILES_ACTIVE=local

# Frontend
VITE_API_BASE_URL=http://localhost:8080
