# SKALA overlay 의 secret.skala.yaml 예시 — 두 Secret 을 한 파일에 포함.
#
# 권장 — 이 파일 직접 편집 X. .env.skala 에서 자동 생성:
#   1) cp .env.skala.example .env.skala  (실값 채움)
#   2) make skala-secret                  (→ secret.skala.yaml 자동 생성)
#
# secret.skala.yaml 은 .gitignore 에 등록되어 있음.
# 이 example 파일은 결과 구조를 보여주기 위한 참고용.
---
# 1) postgres pod 의 환경변수 주입용 — postgres.yaml 의 envFrom secretKeyRef 에서 참조
apiVersion: v1
kind: Secret
metadata:
  name: axis-postgres-bootstrap
  namespace: skala3-finalproj-class3-team13
  labels:
    app: postgres
    app.kubernetes.io/part-of: axis
type: Opaque
stringData:
  POSTGRES_DB: "axis"
  POSTGRES_USER: "axuser"
  POSTGRES_PASSWORD: "REPLACE_DB_PASSWORD"
---
# 2) 앱 컨테이너용 — frontend / backend / ai 가 환경변수로 받음
apiVersion: v1
kind: Secret
metadata:
  name: axis-secrets
  namespace: skala3-finalproj-class3-team13
  labels:
    app.kubernetes.io/part-of: axis
type: Opaque
stringData:
  # DB URL — postgres.yaml 의 Service "postgres" 와 동일 user/pw 여야 함 (위 bootstrap 과 일치)
  DATABASE_URL: "postgresql://axuser:REPLACE_DB_PASSWORD@postgres:5432/axis"
  SPRING_DATASOURCE_URL: "jdbc:postgresql://postgres:5432/axis"
  SPRING_DATASOURCE_USERNAME: "axuser"
  SPRING_DATASOURCE_PASSWORD: "REPLACE_DB_PASSWORD"

  # Qdrant 인증 (현 단계 미설정)
  QDRANT_API_KEY: ""

  # LLM
  OPENAI_API_KEY: "REPLACE_OPENAI_API_KEY"

  # 외부 수집 API
  NAVER_CLIENT_ID: "REPLACE_NAVER_CLIENT_ID"
  NAVER_CLIENT_SECRET: "REPLACE_NAVER_CLIENT_SECRET"
  NAVER_CLIENT_IDS: "REPLACE_NAVER_CLIENT_ID_1,REPLACE_NAVER_CLIENT_ID_2"
  NAVER_CLIENT_SECRETS: "REPLACE_NAVER_CLIENT_SECRET_1,REPLACE_NAVER_CLIENT_SECRET_2"
  DART_API_KEY: "REPLACE_DART_API_KEY"
  KIPRIS_API_KEY: ""
  SARAMIN_API_KEY: ""

  # 백엔드 인증 (application.yml → axis.auth.jwt-secret)
  AXIS_AUTH_JWT_SECRET: "REPLACE_AXIS_AUTH_JWT_SECRET_RANDOM_32BYTES"

  # CronJob → backend 내부 토큰
  CRON_INTERNAL_TOKEN: "REPLACE_CRON_TOKEN_RANDOM"

  # CronJob 실패 Slack 알림 Webhook (비우면 알림 비활성)
  SLACK_WEBHOOK_URL: ""
