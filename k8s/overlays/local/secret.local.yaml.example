# 로컬 K8s 용 Secret 템플릿.
#
# 두 가지 시나리오:
#   1) cloud DB 그대로 사용 (default)
#      → SPRING_DATASOURCE_* / DATABASE_URL / QDRANT_API_KEY 에 실값 입력
#      → axis-infra/.env 의 값을 그대로 복사하면 됨
#
#   2) in-cluster postgres + qdrant 사용 (postgres.yaml + qdrant.yaml 추가 시)
#      → DB URL 이 cluster-internal: postgres:5432 / qdrant:6333
#      → 비밀번호는 postgres.yaml 의 POSTGRES_PASSWORD 와 일치시킴
#
# 본 파일은 .gitignore 등록되지 않으면 절대 실값 커밋 금지!
# 안전한 기본 동작:
#   · 본 파일은 더미 placeholder 만 — secret.local.yaml.example 처럼 동작
#   · 실값 채워서 사용 시 별도 secret.local.yaml.real 같은 이름 권장 + .gitignore
apiVersion: v1
kind: Secret
metadata:
  name: axis-secrets
  namespace: skala3-finalproj-class3-team13
type: Opaque
stringData:
  # ── DB (in-cluster postgres 모드 default 값. cloud 사용 시 Supabase 값으로 교체)
  SPRING_DATASOURCE_URL: "jdbc:postgresql://postgres:5432/axis"
  SPRING_DATASOURCE_USERNAME: "axuser"
  SPRING_DATASOURCE_PASSWORD: "axpass"
  DATABASE_URL: "postgresql://axuser:axpass@postgres:5432/axis"

  # ── Vector (in-cluster qdrant 모드 default. cloud 사용 시 API key 교체)
  QDRANT_API_KEY: ""

  # ── LLM (필수 — 실값 또는 빈값으로 ai 컨테이너만 fail)
  OPENAI_API_KEY: "REPLACE_WITH_YOUR_OPENAI_KEY"

  # ── 외부 수집 (로컬 테스트엔 빈값 OK — 크롤러 전체 fail 무시)
  NAVER_CLIENT_ID: ""
  NAVER_CLIENT_SECRET: ""
  NAVER_CLIENT_IDS: ""
  NAVER_CLIENT_SECRETS: ""
  DART_API_KEY: ""
  KIPRIS_API_KEY: ""
  SARAMIN_API_KEY: ""

  # ── SMTP (로컬엔 빈값 OK — 메일 발송 stub)
  SMTP_USER: ""
  SMTP_PASSWORD: ""

  # ── backend 인증 (application.yml → axis.auth.jwt-secret)
  AXIS_AUTH_JWT_SECRET: "local-dev-jwt-secret-change-me-in-prod-32bytes-min"

  # ── CronJob → backend (로컬에선 cron suspend 라 사용 X, 하지만 빈값이면 backend 가 reject 가능 — 일단 더미)
  CRON_INTERNAL_TOKEN: "local-dev-cron-token"
