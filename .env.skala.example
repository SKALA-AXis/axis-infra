# ============================================================
# AXIS — SKALA EKS 클러스터 배포용 환경변수 템플릿
#
# 사용법:
#   1) cp .env.skala.example .env.skala
#   2) 매니저 받은 실값으로 <REPLACE_*> 채움
#   3) make skala-secret  # → k8s/overlays/skala/secret.skala.yaml 자동 생성
#   4) make skala-apply
#
# .env 와의 차이:
#   · DATABASE_URL / SPRING_DATASOURCE_* — SKALA 클러스터 공용 Postgres
#     (Supabase 가 아닌 cluster 내부 DNS)
#   · QDRANT_HOST — SKALA 클러스터 공용 Qdrant (cluster 내부 DNS)
#   · OPENAI_API_KEY / NAVER_* / DART_API_KEY — .env 와 동일 값 재사용 가능
#
# .env.skala 는 .gitignore 에 등록됨 — 절대 커밋 X
# ============================================================

# ─── PostgreSQL (in-namespace 자체 인스턴스, postgres.yaml 가 배포) ──
# 매니저 가이드: cluster 공용 postgres 가 아니라 본인 namespace 안에 직접 배포.
# DATABASE_URL / SPRING_DATASOURCE_* 는 아래 3 변수에서 자동 derive 됨 — 별도 작성 불필요.
# 강한 password 권장:  openssl rand -base64 24
POSTGRES_DB=axis
POSTGRES_USER=axuser
POSTGRES_PASSWORD=<REPLACE_DB_PW_RANDOM>

# ─── Qdrant (in-namespace 자체 인스턴스, qdrant.yaml 가 배포) ────
QDRANT_HOST=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── LLM ──────────────────────────────────────────────────
# .env 의 키 그대로 복붙 가능 (본인 키) 또는 SKALA 발급 키 사용
OPENAI_API_KEY=<REPLACE_OPENAI_API_KEY>

# ─── 외부 수집 API — .env 와 동일 값 재사용 ───────────────
NAVER_CLIENT_ID=<REPLACE_NAVER_CLIENT_ID>
NAVER_CLIENT_SECRET=<REPLACE_NAVER_CLIENT_SECRET>
DART_API_KEY=<REPLACE_DART_API_KEY>
KIPRIS_API_KEY=
SARAMIN_API_KEY=


# ─── 백엔드 인증 ───────────────────────────────────────────
# application.yml 이 AXIS_AUTH_JWT_SECRET 을 읽음 (JWT_SECRET 아님).
# 32바이트 이상 랜덤. 생성 예: openssl rand -hex 32
AXIS_AUTH_JWT_SECRET=<REPLACE_AXIS_AUTH_JWT_SECRET_RANDOM_32BYTES>

# ─── CronJob → backend 내부 토큰 ──────────────────────────
# 생성 예: openssl rand -hex 16
CRON_INTERNAL_TOKEN=<REPLACE_CRON_TOKEN_RANDOM>

# ─── CronJob 실패 Slack 알림 Webhook ──────────────────────
# Slack App → Incoming Webhooks 에서 발급한 https://hooks.slack.com/services/... URL.
# 비워두면 실패 알림이 비활성화됨 (axis-cron-failure-notifier 가 graceful skip).
SLACK_WEBHOOK_URL=

# ─── 일일 브리핑 수신자 (PII 라 Secret 으로 주입) ──────────
# comma-separated 개인 이메일. ConfigMap 이 아닌 axis-secrets 로 들어가도록 분리됨
# (public repo 전환 시 git tracked manifest 노출 방지). axis-ai 응답의 recipients 가
# 비어있을 때만 backend BriefingService.resolveRecipients 가 fallback 으로 사용.
BRIEFING_RECIPIENTS=<REPLACE_RECIPIENT_EMAILS_COMMA_SEPARATED>
