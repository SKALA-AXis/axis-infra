# ============================================================
# AXIS — 로컬 컨테이너 DB 모드용 환경변수 템플릿
# 사용법:
#   cp .env.local.example .env.local
#   docker compose --profile local --env-file .env.local up -d
# .env.local 파일은 절대 커밋하지 마세요!
# ============================================================

# ─── PostgreSQL (로컬 컨테이너) ──────────────────────────────
# docker-compose 의 postgres 서비스가 사용 — POSTGRES_* 가 컨테이너 초기화 값
POSTGRES_DB=axis
POSTGRES_USER=axuser
POSTGRES_PASSWORD=axpass

# Python(SQLAlchemy/psycopg) — 컨테이너 네트워크 hostname=postgres
DATABASE_URL=postgresql://axuser:axpass@postgres:5432/axis

# SpringBoot용 JDBC — 컨테이너 네트워크 hostname=postgres, sslmode=disable (로컬)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/axis
SPRING_DATASOURCE_USERNAME=axuser
SPRING_DATASOURCE_PASSWORD=axpass

# ─── Qdrant (로컬 컨테이너) ──────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── SpringBoot → Python AI 서버 ────────────────────────────
AI_SERVER_URL=http://ai:8001

# ─── 카드 뉴스 이미지 저장소 ────────────────────────────────
# 컨테이너 안에서 axis-images 볼륨이 마운트되는 경로.
IMAGE_STORAGE_PATH=/data/images

# ─── Crawler API keys ───────────────────────────────────────
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...
NAVER_CLIENT_IDS=...
NAVER_CLIENT_SECRETS=...
DART_API_KEY=...
KIPRIS_API_KEY=...
SARAMIN_API_KEY=...

# ─── Email (v3 — Slack 폐기, 이메일 발송으로 전환) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=axis-briefing@sk.com
BRIEFING_TIME=08:30
BRIEFING_RECIPIENTS=user1@sk.com,user2@sk.com

# ─── MLflow ─────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Spring Profile (local / prod) ──────────────────────────
SPRING_PROFILES_ACTIVE=local
AXIS_AUTH_ENFORCE=true
AXIS_AUTH_ALLOWED_EMAIL_DOMAINS=*
AXIS_AUTH_EMAIL_VERIFICATION_DELIVERY=log
AXIS_APP_BASE_URL=http://localhost:3100

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─── 인증 / 내부 토큰 (K8s Secret 으로 주입) ────────────────
# AXIS_AUTH_JWT_SECRET — backend Spring Security (JWT_SECRET 키는 사용하지 않음)
AXIS_AUTH_JWT_SECRET=local-dev-jwt-secret-change-me-32bytes-min
CRON_INTERNAL_TOKEN=local-dev-cron-token
